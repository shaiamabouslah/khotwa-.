.venv/
__pycache__/
*.pyc
.env

# Crawl outputs: versioned with DVC, not git
/data/raw/
/data/state/crawl.log

# Local web UI accounts (scripts/auth.py) and usage logs (scripts/monitoring.py) --
# per-machine, not shared via git/DVC
/data/users.json
/data/monitoring/

# Pre-downloaded pip wheels (see Dockerfile) -- large binaries, not worth
# versioning; re-downloadable from PyPI/pytorch.org whenever needed.
/wheels/

# Local MLflow store (tracking goes to DagsHub) and local experiment outputs -- never in git
mlruns/
mlflow*.db
data/rag/exp_*/
